+/**
+ * S10 hotfix: attachment objects must live under tickets/<ticketId>/<single-segment>.
+ * Prevents registering/downloading arbitrary objects in the shared bucket.
+ */
+function isPinnedAttachmentPath(ticketId: string, storagePath: unknown): boolean {
+  if (typeof storagePath !== 'string') return false;
+  const prefix = `tickets/${ticketId}/`;
+  if (!storagePath.startsWith(prefix)) return false;
+  const rest = storagePath.slice(prefix.length);
+  return rest.length > 0 && rest.length <= 255 && !/[\\/]/.test(rest) && !rest.includes('..') && !rest.includes('\0');
+}
