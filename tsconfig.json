{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    // Obsolete one-off development/migration scripts (not part of the production
    // bundle, which only builds server/index.ts). Excluded so their stale schema
    // mismatches don't block type-checking of the real application.
    "server/create-sample-student.ts",
    "server/final-verification.ts",
    "server/fix-demo-student-supabase.ts",
    "server/seed.ts",
    "server/seed-supabase.ts",
    "server/check-tables-exist.ts",
    "server/migrate-via-api.ts",
    "server/run-supabase-migrations.ts"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "strict": false,
    "strictNullChecks": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "downlevelIteration": true,
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
