modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["npm", "start"]

[userenv]

[userenv.production]
APP_URL = "https://lumiere-student-portal-v-2.replit.app"
PUBLIC_APP_URL = "https://lumiere-student-portal-v-2.replit.app"
AUTH_EMAIL_MODE = "custom_smtp"
ENABLE_EMAIL_VERIFICATION = "true"
ALLOW_DEMO_MODE = "false"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "S16 production preview"

[[workflows.workflow]]
name = "S16 production preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
